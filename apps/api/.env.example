NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5433/app
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Google login (better-auth) - generate secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me
# URL the browser uses (the Vite dev server proxies /api to this API)
BETTER_AUTH_URL=http://localhost:5173
WEB_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google redirect URI: http://localhost:5173/api/v1/better-auth/callback/google
