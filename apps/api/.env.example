NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5433/app

# Secrets: in production both MUST be random and at least 32 characters, or the server refuses
# to start.  Generate with:  openssl rand -base64 48
JWT_SECRET=change-me-dev-only-change-me-dev-only
# Short-lived: the web app swaps it for a fresh one every 20 minutes (POST /auth/refresh).
JWT_EXPIRES_IN=1h
# How many reverse proxies (nginx, a load balancer, ...) sit in front of the API. Needed so rate
# limits see the real client address; 0 = none (local dev).
TRUST_PROXY=0

# Google login (better-auth). Optional: leave BOTH empty for email + password only.
BETTER_AUTH_SECRET=change-me-dev-only-change-me-dev-only
# URL the browser uses (the Vite dev server proxies /api to this API)
BETTER_AUTH_URL=http://localhost:5173
WEB_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google redirect URI: http://localhost:5173/api/v1/better-auth/callback/google

# Redis (rooms are kept only here, and shared by every API instance). Matches docker-compose.yml.
REDIS_URL=redis://:redis@localhost:6379
# Max participants per room (default 8). Full config: src/config/rooms.config.ts
# ROOM_MAX_MEMBERS=8
# How long a dropped connection keeps its seat before others are told it left (default 15)
# SEAT_GRACE_SECONDS=15

# WebRTC ICE servers. STUN is enough for most networks. TURN (a plain relay, not a media
# server) is needed for peers behind strict NATs, and for hiding IP addresses:
#   TURN_SECRET=$(openssl rand -hex 32) docker compose --profile turn up -d coturn
STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:your-public-host:3478?transport=udp,turn:your-public-host:3478?transport=tcp
# TURN_SECRET=<same value you gave coturn; 32+ characters in production>
# TURN_TTL_SECONDS=3600
# Force every connection through TURN so participants never see each other's IP address
# (recommended for public rooms; needs TURN_URLS):
# FORCE_RELAY=true
