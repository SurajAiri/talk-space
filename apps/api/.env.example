NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5433/app

# Secrets: in production both MUST be random and at least 32 characters, or the server refuses
# to start.  Generate with:  openssl rand -base64 48
JWT_SECRET=change-me-dev-only-change-me-dev-only
# Short-lived: the web app swaps it for a fresh one every 20 minutes (POST /auth/refresh).
JWT_EXPIRES_IN=1h
# How many reverse proxies (nginx, a load balancer, ...) sit in front of the API. Needed so rate
# limits see the real client address; 0 = none (local dev).
TRUST_PROXY=0

# Google login (better-auth). Optional: leave BOTH empty for email + password only.
BETTER_AUTH_SECRET=change-me-dev-only-change-me-dev-only

BETTER_AUTH_URL=http://localhost:3000
WEB_URLS=http://localhost:5173,http://localhost:5174
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google redirect URI: http://localhost:5173/api/v1/better-auth/callback/google

# Redis (rooms are kept only here, and shared by every API instance). Matches docker-compose.yml.
REDIS_URL=redis://:redis@localhost:6379
# Max participants per room (default 8). Full config: src/config/rooms.config.ts
# ROOM_MAX_MEMBERS=8
# How long a dropped connection keeps its seat before others are told it left (default 15)
# SEAT_GRACE_SECONDS=15

# WebRTC ICE servers. STUN alone only works when both people's networks are "friendly". On mobile /
# carrier-grade / symmetric NAT it does NOT, and the symptom is a person who is listed in the room
# but stays on "Connecting..." and then "Can't connect". TURN (a plain relay, not a media server)
# is the fix, and it is effectively required for a public app. STUN stays as is: it is not the problem.
# Leaving TURN_URLS commented out = TURN OFF. The API prints "ICE: ... TURN OFF" at boot when that is the case.
STUN_URLS=stun:stun.l.google.com:19302

# --- Option A: hosted TURN with a fixed login (e.g. ExpressTURN free tier) ---------------------
# Copy the exact host/ports/username/password from the provider's dashboard. Keep the ?transport=tcp
# and turns:...:443 entries: they rescue networks that block UDP.
# TURN_URLS=turn:relay1.expressturn.com:3478?transport=udp,turn:relay1.expressturn.com:3478?transport=tcp,turns:relay1.expressturn.com:443?transport=tcp
# TURN_USERNAME=<from the provider dashboard>
# TURN_CREDENTIAL=<from the provider dashboard>
# NOTE: this login is sent to every joined user's browser and never expires. Do not commit it, watch the
# provider's usage page, and rotate it if the quota drains faster than your real usage explains.

# --- Option B: your own coturn (see docker-compose.yml, profile "turn") -------------------------
#   1. On a machine with a public IP:
#        export TURN_SECRET=$(openssl rand -hex 32); echo "$TURN_SECRET"
#        export TURN_EXTERNAL_IP=<its public IP>
#        docker compose --profile turn up -d coturn
#   2. Put the SAME secret below, and open ports 3478 (udp+tcp) and 49152-50151 (udp) on that machine.
# TURN_URLS=turn:your-public-host:3478?transport=udp,turn:your-public-host:3478?transport=tcp
# TURN_SECRET=<same value you gave coturn; 32+ characters in production>
# TURN_TTL_SECONDS=3600
#
# Use Option A or B, not both (the API refuses to start if both credential styles are set).
# Either way, join a room: the browser console should print "[webrtc] ICE setup { turn: true }", and a
# call through the relay prints "connected to ...: relay <-> ... (through TURN)".

# Force every connection through TURN so participants never see each other's IP address
# (needs TURN_URLS). Leave OFF until TURN is proven to work from two different networks,
# because with this on, a dead TURN server means nobody can connect at all.
# FORCE_RELAY=true


# you might get these above too but these are here too for simplicity
# TURN_URLS=turn:<your-server>:3478?transport=udp,turn:<your-server>:3478?transport=tcp,turns:<your-server>:443?transport=tcp
# TURN_USERNAME=<your username>
# TURN_CREDENTIAL=<your password>