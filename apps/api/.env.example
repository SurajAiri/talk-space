NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Google login (better-auth) - generate secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me
# URL the browser uses (the Vite dev server proxies /api to this API)
BETTER_AUTH_URL=http://localhost:5173
WEB_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google redirect URI: http://localhost:5173/api/v1/better-auth/callback/google

# Redis (rooms are kept only here). Matches docker-compose.yml defaults.
REDIS_URL=redis://:redis@localhost:6379
# Max participants per room (default 8). Full config: src/config/rooms.config.ts
# ROOM_MAX_MEMBERS=8

# WebRTC ICE servers. TURN is optional but recommended for production
# (coturn: `docker compose --profile turn up -d coturn`).
STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
# TURN_SECRET=change-me-too
# TURN_TTL_SECONDS=3600
