{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "env":[
"GOOGLE_CLIENT_ID",
"GOOGLE_CLIENT_SECRET",
"JWT_EXPIRES_IN",
"JWT_SECRET",
"NODE_ENV",
"PORT",
"REDIS_URL",
"STUN_URLS",
"TRUST_PROXY",
"TURN_CREDENTIAL",
"TURN_URLS",
"TURN_USERNAME",
"WEB_URLS",
"ENABLE_EXPERIMENTAL_COREPACK",
"BETTER_AUTH_SECRET",
"BETTER_AUTH_URL",
"DATABASE_URL"

      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

